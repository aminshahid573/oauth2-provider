# =============================================================================
# Authexa Configuration
# =============================================================================
# Copy this file to .env and replace all CHANGE_ME values before running.
# See docs/SETUP.md for detailed generation instructions.
# =============================================================================

# Application Environment: development, staging, production
APP_ENV=development

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# Logging Configuration: debug, info, warn, error
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# MongoDB credentials used by docker-compose to bootstrap the database.
MONGO_ROOT_USER=CHANGE_ME
MONGO_ROOT_PASSWORD=CHANGE_ME

# MongoDB connection URI.
# Replace user/password with the values above.
MONGO_URI=mongodb://CHANGE_ME:CHANGE_ME@localhost:27017/authexa?authSource=admin

# Redis connection details.
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# -----------------------------------------------------------------------------
# JWT Configuration
# -----------------------------------------------------------------------------
# Symmetric secret used for HMAC operations (min 32 chars).
# Generate: openssl rand -base64 32
JWT_SECRET_KEY=CHANGE_ME

# RSA-2048 private key for signing JWTs (PEM, then base64-encoded).
# Generate:
#   openssl genpkey -algorithm RSA -out private.pem -pkeyopt rsa_keygen_bits:2048
#   base64 -w 0 private.pem        # Linux
#   base64 -i private.pem           # macOS
JWT_PRIVATE_KEY_BASE64=CHANGE_ME

JWT_ISSUER=authexa
JWT_ACCESS_TOKEN_LIFESPAN_MINUTES=15
JWT_REFRESH_TOKEN_LIFESPAN_HOURS=168

# -----------------------------------------------------------------------------
# Frontend / CSRF
# -----------------------------------------------------------------------------
BASE_URL=http://localhost:8080

# 32-byte random key for CSRF token signing.
# Generate: openssl rand -base64 32 | head -c 32
CSRF_AUTH_KEY=CHANGE_ME

# -----------------------------------------------------------------------------
# Security Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins for CORS.
# Use specific origins in production; never use '*'.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# -----------------------------------------------------------------------------
# Rate Limiting Configuration
# -----------------------------------------------------------------------------
RATE_LIMIT_GLOBAL_ENABLED=true
RATE_LIMIT_GLOBAL_RPS=10
RATE_LIMIT_GLOBAL_BURST=20

RATE_LIMIT_TOKEN_ENABLED=true
RATE_LIMIT_TOKEN_RPS=5
RATE_LIMIT_TOKEN_BURST=10
